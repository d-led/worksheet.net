<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Worksheet.Desktop.ViewModels"
             x:Class="Worksheet.Desktop.Components.DayHeader"
             x:DataType="vm:DayViewModel">

  <!--
    Navigation, the day it is on, the calendar to jump anywhere, and the export. The arrows are
    44x44 targets, because the previous version's 24x24 glyphs were the most-complained-about
    control.
  -->
  <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">

    <Button x:Name="PreviousDay"
            Grid.Column="0"
            Classes="nav"
            Content="❮"
            Command="{Binding PreviousDayCommand}"
            ToolTip.Tip="Previous day" />

    <Button x:Name="NextDay"
            Grid.Column="1"
            Classes="nav"
            Content="❯"
            Command="{Binding NextDayCommand}"
            ToolTip.Tip="Next day" />

    <TextBlock x:Name="DayTitle" Grid.Column="2" Classes="title" Text="{Binding DayTitle}" Margin="8,0" />

    <!--
      The calendar: a glyph rather than a number, so nothing in the heading can be read as a date
      of its own, and a popup that closes when a day is picked or the visit is over.
    -->
    <Button x:Name="Calendar"
            Grid.Column="3"
            Classes="nav"
            VerticalAlignment="Center"
            ToolTip.Tip="Pick a day">
      <PathIcon Data="{StaticResource CalendarGlyph}" Width="17" Height="17" />
      <Button.Flyout>
        <Flyout Placement="BottomEdgeAlignedLeft" Opened="OnCalendarOpened">
          <Calendar SelectedDatesChanged="OnDayPicked" LostFocus="OnCalendarLeft" />
        </Flyout>
      </Button.Flyout>
    </Button>

    <Button x:Name="Today"
            Grid.Column="4"
            Content="Today"
            Command="{Binding ShowTodayCommand}"
            VerticalAlignment="Center" />

    <!-- What the day is worth as work: a break is on the day but is not counted here. -->
    <TextBlock x:Name="Total"
               Grid.Column="5"
               Classes="total"
               Text="{Binding Total}"
               MinWidth="96"
               TextAlignment="Right"
               ToolTip.Tip="Time worked, breaks left out" />

    <!-- One click exports the month the day belongs to; the arrow offers the other three ranges. -->
    <SplitButton x:Name="Export"
                 Grid.Column="6"
                 Content="Export month"
                 Command="{Binding ExportMonthCommand}"
                 VerticalAlignment="Center"
                 ToolTip.Tip="Export the month, or another range, as a zip of JSON and an HTML page">
      <SplitButton.Flyout>
        <MenuFlyout>
          <MenuItem x:Name="ExportDay" Header="Day" Tag="Day" />
          <MenuItem x:Name="ExportMonth" Header="Month" Tag="Month" />
          <MenuItem x:Name="ExportQuarter" Header="Quarter" Tag="Quarter" />
          <MenuItem x:Name="ExportYear" Header="Year" Tag="Year" />
        </MenuFlyout>
      </SplitButton.Flyout>
    </SplitButton>

    <!--
      The same four screens the tray offers. A menu-bar icon is not a way in on a platform without
      one, and the heading is where a person looks first on any of them.
    -->
    <Button x:Name="Screens"
            Grid.Column="7"
            Content="⋯"
            VerticalAlignment="Center"
            ToolTip.Tip="Settings, projects and topics, the agent connection, the data folder">
      <Button.Flyout>
        <MenuFlyout>
          <MenuItem x:Name="OpenSettings" Header="Settings…" />
          <MenuItem x:Name="OpenManage" Header="Projects and topics…" />
          <MenuItem x:Name="OpenConnect" Header="Connect an agent…" />
          <MenuItem x:Name="OpenDataFolder" Header="Open data folder" />
          <MenuItem x:Name="OpenAudit" Header="The journal…" />
        </MenuFlyout>
      </Button.Flyout>
    </Button>

  </Grid>
</UserControl>
