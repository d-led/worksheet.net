<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Worksheet.Desktop.ViewModels"
             x:Class="Worksheet.Desktop.Components.QuickEntry"
             x:DataType="vm:DayViewModel">

  <!--
    One line, and under it an answer to "what now": the shape of a line in four parts with the
    next one named, then what the line will do to the day — the work it crosses and what is left of
    it, so an interruption over planned work is visible before Enter rather than after it. The hint
    wraps rather than clips, because once the day has an end to continue from it offers the start's
    place kept open beside the clock. Known names are chips below: the arrows walk them and Tab
    takes the one they are on.
  -->
  <StackPanel Spacing="5">

    <TextBox x:Name="EntryBox"
             Classes="entry"
             Text="{Binding EntryText}"
             PlaceholderText="Website (login) 09:00 1h30m">
      <TextBox.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{Binding LogCommand}" />
      </TextBox.KeyBindings>
    </TextBox>

    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
      <TextBlock Classes="legend" Text="project › (topic) › 09:00 › 1h30m › # note" VerticalAlignment="Center" />
      <TextBlock x:Name="NextStep"
                 Grid.Column="1"
                 Classes="hint"
                 Classes.warn="{Binding NextStepIsWarning}"
                 Text="{Binding NextStep}"
                 TextWrapping="Wrap"
                 VerticalAlignment="Center" />
    </Grid>

    <TextBlock x:Name="Preview"
               Classes="meta"
               Text="{Binding Preview}"
               IsVisible="{Binding HasPreview}"
               TextWrapping="Wrap" />

    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasSuggestions}">
      <TextBlock x:Name="SuggestionCaption"
                 Classes="caption"
                 Text="{Binding SuggestionCaption}"
                 VerticalAlignment="Center"
                 Margin="2,0,4,0" />
      <ItemsControl x:Name="Suggestions" ItemsSource="{Binding Suggestions}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Classes="chip"
                    Classes.chosen="{Binding IsSelected}"
                    Content="{Binding Text}"
                    Command="{Binding Use}"
                    Margin="0,0,6,0" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

  </StackPanel>
</UserControl>
