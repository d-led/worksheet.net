<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                 xmlns:c="using:Worksheet.Desktop.Components"
                 xmlns:vm="using:Worksheet.Desktop.ViewModels"
                 x:Class="Worksheet.Desktop.Views.MainWindow"
                 x:DataType="vm:DayViewModel"
                 Title="Worksheet.net"
Width="1000"
                 Height="620"
                 MinWidth="760"
                 MinHeight="460">

  <suki:SukiWindow.KeyBindings>
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Meta+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Meta+Shift+Z" Command="{Binding RedoCommand}" />
  </suki:SukiWindow.KeyBindings>

  <!--
    The window is a composition of six components and nothing else, on one flat page. The banner
    stands between the heading and the day: what the heading's export just did is news about the
    day, and it goes as soon as it has been read.
  -->
  <Border Classes="page" Padding="20,12,20,16">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="12">
      <c:DayHeader x:Name="Header" Grid.Row="0" />
      <c:ExportBanner x:Name="Exported" Grid.Row="1" />
      <c:DayStatus x:Name="DayKind" Grid.Row="2" />
      <c:QuickEntry x:Name="Entry" Grid.Row="3" IsVisible="{Binding !IsFrozen}" />
      <c:DayTable x:Name="Table" Grid.Row="4" />
      <c:StatusLine x:Name="Status" Grid.Row="5" />
    </Grid>
  </Border>

</suki:SukiWindow>
