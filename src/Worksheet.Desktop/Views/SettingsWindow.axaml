<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                 xmlns:vm="using:Worksheet.Desktop.ViewModels"
                 x:Class="Worksheet.Desktop.Views.SettingsWindow"
                 x:DataType="vm:SettingsViewModel"
                 Title="Settings"
                 Width="640"
                 Height="380"
                 MinWidth="520"
                 MinHeight="320"
                 WindowStartupLocation="CenterOwner">

  <!--
    Each knob on one line: what it is, the value in force, and where that value came from — so a
    number nobody typed here is not mistaken for one that was.
  -->
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="12" Margin="20">

    <TextBlock Grid.Row="0" Classes="title" Text="Settings" />

    <Grid Grid.Row="1" ColumnDefinitions="160,120,*" ColumnSpacing="10">
      <TextBlock Grid.Column="0" Text="MCP port" VerticalAlignment="Center" />
      <TextBox x:Name="PortBox" Grid.Column="1" Text="{Binding PortText}" />
      <TextBlock x:Name="PortSource"
                 Grid.Column="2"
                 Classes="quiet"
                 Text="{Binding PortSource}"
                 VerticalAlignment="Center" />
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="160,120,*" ColumnSpacing="10">
      <TextBlock Grid.Column="0" Text="Snapshot every" VerticalAlignment="Center" />
      <TextBox x:Name="SnapshotBox" Grid.Column="1" Text="{Binding SnapshotText}" />
      <TextBlock x:Name="SnapshotSource"
                 Grid.Column="2"
                 Classes="quiet"
                 Text="{Binding SnapshotSource}"
                 VerticalAlignment="Center" />
    </Grid>

    <TextBlock Grid.Row="3"
               Classes="quiet"
               TextWrapping="Wrap"
               Text="Port zero leaves the MCP server off. The server starts or stops as soon as this is saved; the snapshot interval is read when the application starts." />

    <Grid Grid.Row="4" ColumnDefinitions="160,*" ColumnSpacing="10">
      <TextBlock Grid.Column="0" Classes="quiet" Text="Data folder" />
      <TextBlock x:Name="DataDirectory"
                 Grid.Column="1"
                 Classes="quiet"
                 Text="{Binding DataDirectory}"
                 TextWrapping="Wrap" />
    </Grid>

    <TextBlock x:Name="Message"
               Grid.Row="5"
               Classes="meta"
               Classes.problem="{Binding MessageIsProblem}"
               Text="{Binding Message}"
               IsVisible="{Binding HasMessage}"
               TextWrapping="Wrap" />

    <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
      <Button x:Name="Save" Content="Save" Click="Save_Click" />
      <Button x:Name="Revert" Content="Revert to defaults" Click="Revert_Click" />
      <Button x:Name="CloseButton" Content="Close" Click="Close_Click" />
    </StackPanel>

  </Grid>

</suki:SukiWindow>
