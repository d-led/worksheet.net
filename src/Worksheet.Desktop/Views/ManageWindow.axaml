<local:SecondaryWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="using:Worksheet.Desktop.Views"
                 xmlns:vm="using:Worksheet.Desktop.ViewModels"
                 x:Class="Worksheet.Desktop.Views.ManageWindow"
                 x:DataType="vm:ManageViewModel"
                 Title="Projects and topics"
                 Width="820"
                 Height="640"
                 MinWidth="660"
                 MinHeight="520"
                 WindowStartupLocation="CenterOwner">

  <!--
    Every row carries its own name, so renaming is typing into the row and pressing Enter: no second
    box, no dialog and no confirmation step. The line above the message says what Enter will do while
    the name is still being typed, which is what makes a merge — the same keystroke, one name fewer —
    something a person chooses rather than something that happens to them.
  -->
  <Border Classes="page" Padding="20">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,*,Auto,Auto" RowSpacing="8">

      <TextBlock Grid.Row="0" Classes="title" Text="Projects and topics" />

      <TextBlock Grid.Row="1"
                 Classes="quiet"
                 TextWrapping="Wrap"
                 Text="A name is typed where it stands: Enter or leaving the field keeps it, Escape puts the old one back and then leaves. A name another row already answers to merges the two, hours and all, into one name." />

      <TextBlock Grid.Row="2" Classes="caption" Text="PROJECTS" />

      <ListBox x:Name="ProjectList"
               Grid.Row="3"
               ItemsSource="{Binding Projects}"
               SelectedItem="{Binding SelectedProject}"
               Background="Transparent"
               BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:CatalogueRow">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,2">
              <TextBox x:Name="ProjectName"
                       Classes="cell"
                       Text="{Binding Draft}"
                       GotFocus="Row_Focused"
                       LostFocus="Row_Left">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding CommitCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
              <TextBlock Grid.Column="1"
                         Classes="quiet"
                         Text="{Binding Holds}"
                         MinWidth="130"
                         VerticalAlignment="Center" />
              <Button Grid.Column="2"
                      Classes="row-word"
                      Content="Archive"
                      Command="{Binding ArchiveCommand}"
                      ToolTip.Tip="Stop offering this name; every entry keeps it" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Grid.Row="4" Classes="caption" Text="TOPICS OF THE CHOSEN PROJECT" />

      <ListBox x:Name="TopicList"
               Grid.Row="5"
               ItemsSource="{Binding Topics}"
               Background="Transparent"
               BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:CatalogueRow">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,2">
              <TextBox x:Name="TopicName"
                       Classes="cell"
                       Text="{Binding Draft}"
                       GotFocus="Row_Focused"
                       LostFocus="Row_Left">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding CommitCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
              <TextBlock Grid.Column="1"
                         Classes="quiet"
                         Text="{Binding Holds}"
                         MinWidth="130"
                         VerticalAlignment="Center" />
              <Button Grid.Column="2"
                      Classes="row-word"
                      Content="Remove"
                      Command="{Binding ArchiveCommand}"
                      ToolTip.Tip="Stop offering this topic; every entry keeps it" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock x:Name="Proposal"
                 Grid.Row="6"
                 Classes="hint"
                 Text="{Binding Proposal}"
                 IsVisible="{Binding HasProposal}"
                 TextWrapping="Wrap" />

      <Grid Grid.Row="7" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBlock x:Name="Message"
                   Grid.Column="0"
                   Classes="meta"
                   Classes.problem="{Binding MessageIsProblem}"
                   Text="{Binding Message}"
                   IsVisible="{Binding HasMessage}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" />
        <Button x:Name="Undo" Grid.Column="1" Content="Undo" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" />
        <Button x:Name="CloseButton" Grid.Column="2" Content="Close" Click="Close_Click" />
      </Grid>

    </Grid>
  </Border>

</local:SecondaryWindow>
