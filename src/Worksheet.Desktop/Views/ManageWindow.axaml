<local:SecondaryWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="using:Worksheet.Desktop.Views"
                 xmlns:vm="using:Worksheet.Desktop.ViewModels"
                 x:Class="Worksheet.Desktop.Views.ManageWindow"
                 x:DataType="vm:ManageViewModel"
                 Title="Projects and topics"
                 Width="820"
                 Height="640"
                 MinWidth="660"
                 MinHeight="520"
                 WindowStartupLocation="CenterOwner">

  <!--
    Every row carries its own name, so renaming is typing into the row and pressing Enter: no second
    box, no dialog and no confirmation step. A bubble at the foot of the list says what Enter will do
    while the name is still being typed — and that nothing is written until then — which is what makes
    a merge, the same keystroke with one name fewer, something a person chooses rather than something
    that happens to them.
  -->
  <local:SecondaryWindow.Resources>
    <!--
      One row, one template: the name in a field of its own, then what the row holds and the word
      that takes it out of the catalogue. "Archive" on a project, "Remove" on a topic: the same
      decision, named for what a person is looking at.
    -->
    <DataTemplate x:Key="NameRow" x:DataType="vm:CatalogueRow">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,2">
        <TextBox Grid.Column="0"
                 x:Name="NameField"
                 Classes="cell"
                 Text="{Binding Draft}"
                 GotFocus="Row_Focused"
                 LostFocus="Row_Left">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding CommitCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <TextBlock Grid.Column="1"
                   Classes="quiet"
                   Text="{Binding Holds}"
                   MinWidth="130"
                   VerticalAlignment="Center" />
        <Button Grid.Column="2"
                Classes="row-word"
                Content="{Binding ActionWord}"
                Command="{Binding ArchiveCommand}"
                ToolTip.Tip="{Binding ActionTip}" />
      </Grid>
    </DataTemplate>
  </local:SecondaryWindow.Resources>

  <Border Classes="page" Padding="20">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="8">

      <TextBlock Grid.Row="0" Classes="title" Text="Projects and topics" />

      <TextBlock Grid.Row="1"
                 Classes="quiet"
                 TextWrapping="Wrap"
                 Text="A name is typed where it stands: Enter or leaving the field keeps it, Escape puts the old one back and then leaves. A name another row already answers to merges the two, hours and all, into one name." />

      <TextBlock Grid.Row="2" Classes="caption" Text="PROJECTS" />

      <ListBox x:Name="ProjectList"
               Grid.Row="3"
               ItemsSource="{Binding Projects}"
               SelectedItem="{Binding SelectedProject}"
               ItemTemplate="{StaticResource NameRow}"
               MaxHeight="220"
               Background="Transparent"
               BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

      <!--
        What Enter would do with the name being typed, in a bubble at the foot of the list it is in:
        a name is settled where it stands, so the sentence that makes a rename or a merge visible
        before the key is pressed has to stand where the typing is.
      -->
      <Border x:Name="ProjectNote"
              Grid.Row="4"
              Classes="bubble"
              IsVisible="{Binding HasProjectNote}"
              HorizontalAlignment="Left"
              MaxWidth="560">
        <TextBlock Classes="quiet" Text="{Binding ProjectNote}" TextWrapping="Wrap" />
      </Border>

      <TextBlock Grid.Row="5" Classes="caption" Text="TOPICS OF THE CHOSEN PROJECT" />

      <ListBox x:Name="TopicList"
               Grid.Row="6"
               ItemsSource="{Binding Topics}"
               ItemTemplate="{StaticResource NameRow}"
               MaxHeight="180"
               Background="Transparent"
               BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

      <Border x:Name="TopicNote"
              Grid.Row="7"
              Classes="bubble"
              IsVisible="{Binding HasTopicNote}"
              HorizontalAlignment="Left"
              MaxWidth="560">
        <TextBlock Classes="quiet" Text="{Binding TopicNote}" TextWrapping="Wrap" />
      </Border>

      <Grid Grid.Row="9" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBlock x:Name="Message"
                   Grid.Column="0"
                   Classes="meta"
                   Classes.problem="{Binding MessageIsProblem}"
                   Text="{Binding Message}"
                   IsVisible="{Binding HasMessage}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" />
        <Button x:Name="Undo" Grid.Column="1" Content="Undo" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" />
        <Button x:Name="CloseButton" Grid.Column="2" Content="Close" Click="Close_Click" />
      </Grid>

    </Grid>
  </Border>

</local:SecondaryWindow>
