<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    The only place a font size, a row height or a surface is decided. Controls and views use these
    classes and never set a size inline. The scale is deliberately small: a working day is ten
    rows, and they should fit.
  -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.total">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>

  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style Selector="TextBlock.numeric">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="TextBlock.meta">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.meta.problem">
    <Setter Property="Foreground" Value="#E5484D" />
  </Style>

  <Style Selector="TextBlock.quiet">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <Style Selector="TextBlock.legend">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>

  <Style Selector="TextBlock.gap-span">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <Style Selector="TextBlock.gap-note">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Opacity" Value="0.35" />
  </Style>

  <Style Selector="Button.nav">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.chip">
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>

  <!-- The chip the arrow keys are on: the one Tab would take. -->
  <Style Selector="Button.chip.chosen">
    <Setter Property="Background" Value="#2F6FED" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.row-action">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="TextBox.entry">
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="11,7" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style Selector="TextBox.cell">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="7,1" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="ComboBox.cell">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="7,1" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.row">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
  </Style>

  <Style Selector="Border.gap">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
  </Style>

  <!--
    The day's status: five small radios, each with its own colour once chosen. The colours are
    here rather than in the views, and they say what the day means: green for a day that works,
    red for one that does not.
  -->
  <Style Selector="RadioButton.kind">
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="RadioButton.kind:checked">
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="RadioButton.kind[Tag=Working]:checked">
    <Setter Property="Background" Value="#2E9E63" />
  </Style>

  <Style Selector="RadioButton.kind[Tag=Flex]:checked">
    <Setter Property="Background" Value="#2F6FED" />
  </Style>

  <Style Selector="RadioButton.kind[Tag=Sick]:checked">
    <Setter Property="Background" Value="#E5484D" />
  </Style>

  <Style Selector="RadioButton.kind[Tag=Holiday]:checked">
    <Setter Property="Background" Value="#C98A18" />
  </Style>

  <Style Selector="RadioButton.kind[Tag=Weekend]:checked">
    <Setter Property="Background" Value="#6B7280" />
  </Style>

</Styles>
