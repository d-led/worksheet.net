<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI">

  <!--
    The only place a font size, a row height or a surface is decided. Controls and views use these
    classes and never set a size inline. Secondary text is a colour, not a transparency: a grey at
    half opacity over a grey page is what made the day unreadable.
  -->
  <Style Selector="suki|SukiWindow">
    <Setter Property="Background" Value="{DynamicResource PageBrush}" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.total">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>

  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>

  <Style Selector="TextBlock.numeric">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MutedInkBrush}" />
  </Style>

  <Style Selector="TextBlock.meta">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource MutedInkBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.meta.problem">
    <Setter Property="Foreground" Value="#C0272D" />
  </Style>

  <Style Selector="TextBlock.quiet">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource MutedInkBrush}" />
  </Style>

  <Style Selector="TextBlock.legend">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MutedInkBrush}" />
  </Style>

  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource MutedInkBrush}" />
  </Style>

  <Style Selector="TextBlock.gap-span">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource MutedInkBrush}" />
  </Style>

  <Style Selector="TextBlock.gap-note">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource MutedInkBrush}" />
  </Style>

  <Style Selector="Button.nav">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.chip">
    <Setter Property="Padding" Value="11,4" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>

  <!-- The chip the arrow keys are on: the one Tab would take. -->
  <Style Selector="Button.chip.chosen">
    <Setter Property="Background" Value="#2F6FED" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.row-action">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="TextBox.entry">
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="FontSize" Value="16" />
  </Style>

  <Style Selector="TextBox.cell">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="ComboBox.cell">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!--
    A disabled field still has something to say: on a frozen day the row is what was worked, so it
    keeps a readable ink instead of the theme's washed-out one. The field being disabled is what
    says it cannot be changed.
  -->
  <Style Selector="TextBox.cell:disabled">
    <Setter Property="Foreground" Value="{DynamicResource MutedInkBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="ComboBox.cell:disabled">
    <Setter Property="Foreground" Value="{DynamicResource MutedInkBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Border.cell-frame AutoCompleteBox:disabled">
    <Setter Property="Foreground" Value="{DynamicResource MutedInkBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Border.cell-frame AutoCompleteBox /template/ TextBox">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.cell-frame AutoCompleteBox /template/ TextBox:disabled">
    <Setter Property="Foreground" Value="{DynamicResource MutedInkBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!--
    An auto-completing cell draws no frame of its own, so the frame is drawn around it: the same
    hairline a text box gets, so a row still reads as one line of fields.
  -->
  <Style Selector="Border.cell-frame">
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.cell-frame AutoCompleteBox">
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Border.row">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="5,3" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
  </Style>

  <Style Selector="Border.gap">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
  </Style>

  <!--
    The day's status: five small radios, each with its own colour once chosen. They are drawn as
    pills rather than as the skin's radio button — the bullet is there to say "one of these", and
    the row already says that — so the shape is this application's, and the colour means something:
    green for a day that works, red for one that does not.
  -->
  <Style Selector="RadioButton.kind">
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <TextBlock Name="Label"
                     Text="{TemplateBinding Content}"
                     Foreground="{TemplateBinding Foreground}"
                     FontSize="{TemplateBinding FontSize}"
                     FontWeight="{TemplateBinding FontWeight}"
                     VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="RadioButton.kind:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <Style Selector="RadioButton.kind:checked">
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="RadioButton.kind[Tag=Working]:checked">
    <Setter Property="Background" Value="#2E9E63" />
    <Setter Property="BorderBrush" Value="#2E9E63" />
  </Style>

  <Style Selector="RadioButton.kind[Tag=Flex]:checked">
    <Setter Property="Background" Value="#2F6FED" />
    <Setter Property="BorderBrush" Value="#2F6FED" />
  </Style>

  <Style Selector="RadioButton.kind[Tag=Sick]:checked">
    <Setter Property="Background" Value="#E5484D" />
    <Setter Property="BorderBrush" Value="#E5484D" />
  </Style>

  <Style Selector="RadioButton.kind[Tag=Holiday]:checked">
    <Setter Property="Background" Value="#C98A18" />
    <Setter Property="BorderBrush" Value="#C98A18" />
  </Style>

  <Style Selector="RadioButton.kind[Tag=Weekend]:checked">
    <Setter Property="Background" Value="#6B7280" />
    <Setter Property="BorderBrush" Value="#6B7280" />
  </Style>

</Styles>
