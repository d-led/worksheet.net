<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The bundle the application is copied into /Applications as. `scripts/package.sh` writes
  @VERSION@ in from the build and adds AppIcon.icns next to it.

  The application keeps a Dock icon as well as a menu-bar one. That is not an accident: macOS hands
  an application no click for its menu-bar icon, so the Dock icon is the only one that can be clicked
  to bring the window back. Closing the window therefore minimises it, where the Dock shows it and
  its icon restores it. Avalonia says the same at start-up with MacOSPlatformOptions.ShowInDock,
  which is why this file no longer claims LSUIElement.
-->
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>Worksheet</string>
  <key>CFBundleDisplayName</key>
  <string>Worksheet</string>
  <key>CFBundleIdentifier</key>
  <string>com.d-led.worksheet</string>
  <key>CFBundleExecutable</key>
  <string>worksheet</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleIconFile</key>
  <string>AppIcon</string>
  <key>CFBundleShortVersionString</key>
  <string>@VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@VERSION@</string>
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
</dict>
</plist>
