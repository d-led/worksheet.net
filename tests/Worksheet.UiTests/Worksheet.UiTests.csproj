<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Worksheet.UiTests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Avalonia.Headless.XUnit is built on xunit v3 and pins its extensibility API to 3.2.2:
    the 4.x line changed TestIntrospectionHelper.GetTestCaseDetails, which that package calls,
    so 3.2.2 is the newest xunit v3 these UI tests can run on. Everything else is current.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="coverlet.collector" Version="10.1.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.6" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Worksheet.Desktop\Worksheet.Desktop.csproj" />
    <ProjectReference Include="..\Worksheet.TestSupport\Worksheet.TestSupport.csproj" />
  </ItemGroup>

</Project>
